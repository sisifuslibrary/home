<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tabla de archivos</title>
    <style>
        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
            box-sizing: border-box;
        }

        .contenedor {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            width: 100%;
            max-width: 500px;
        }

        h1 {
            font-size: 1.5rem;
            margin-top: 0;
            margin-bottom: 1.5rem;
            color: #1e293b;
            text-align: center;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1rem;
        }

        th {
            text-align: left;
            padding: 0.75rem 1rem;
            background-color: #e2e8f0;
            color: #334155;
            font-weight: 600;
            border-bottom: 2px solid #cbd5e1;
        }

        th:first-child {
            border-top-left-radius: 8px;
        }

        th:last-child {
            border-top-right-radius: 8px;
        }

        td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            color: #0f172a;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background-color: #f8fafc;
        }

        a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: color 0.2s;
        }

        a:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        a::before {
            content: "📄";
            font-size: 1rem;
        }

        .archivo {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <div class="contenedor">
        <h1>Archivos en la raíz</h1>
        <table>
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th>Enlace</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="archivo">color.md</td>
                    <td><a href="color.md" target="_blank">Abrir color.md</a></td>
                </tr>
                <tr>
                    <td class="archivo">piranesi.md</td>
                    <td><a href="piranesi.md" target="_blank">Abrir piranesi.md</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>
