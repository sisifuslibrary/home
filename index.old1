<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tabla de archivos</title>

    <!-- 1. Componente zero-md -->
    <script type="module" src="https://cdn.jsdelivr.net/npm/zero-md@3?register"></script>

    <style>
        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 1rem;
            box-sizing: border-box;
        }

        .contenedor {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            width: 100%;
            max-width: 500px;
        }

        h1 {
            font-size: 1.5rem;
            margin-top: 0;
            margin-bottom: 1.5rem;
            color: #1e293b;
            text-align: center;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1rem;
        }

        th {
            text-align: left;
            padding: 0.75rem 1rem;
            background-color: #e2e8f0;
            color: #334155;
            font-weight: 600;
            border-bottom: 2px solid #cbd5e1;
        }

        th:first-child {
            border-top-left-radius: 8px;
        }

        th:last-child {
            border-top-right-radius: 8px;
        }

        td {
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            color: #0f172a;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background-color: #f8fafc;
        }

        a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: color 0.2s;
            cursor: pointer;
        }

        a:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        a::before {
            content: "📄";
            font-size: 1rem;
        }

        .archivo {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 0.95rem;
        }

        /* --- Estilos del modal visor --- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            display: none;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            z-index: 1000;
        }

        .modal-overlay.activo {
            display: flex;
        }

        .modal-contenido {
            background: #ffffff;
            border-radius: 12px;
            width: 100%;
            max-width: 850px;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.1rem;
            color: #1e293b;
            font-weight: 600;
        }

        .cerrar-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            line-height: 1;
            color: #64748b;
            cursor: pointer;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
        }

        .cerrar-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .modal-body {
            overflow-y: auto;
            padding: 1.5rem;
        }

        /* Estilos internos de zero-md */
        zero-md {
            display: block;
        }
    </style>
</head>
<body>
    <div class="contenedor">
        <h1>Archivos en la raíz</h1>
        <table>
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th>Enlace</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="archivo">color.md</td>
                    <td><a href="#" data-src="color.md">Abrir color.md</a></td>
                </tr>
                <tr>
                    <td class="archivo">piranesi.md</td>
                    <td><a href="#" data-src="piranesi.md">Abrir piranesi.md</a></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Visor modal -->
    <div class="modal-overlay" id="visorOverlay">
        <div class="modal-contenido">
            <div class="modal-header">
                <h2 id="visorTitulo">Visor</h2>
                <button class="cerrar-btn" id="cerrarVisor" aria-label="Cerrar">&times;</button>
            </div>
            <div class="modal-body">
                <zero-md id="visorMd" no-shadow></zero-md>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const overlay = document.getElementById('visorOverlay');
            const titulo  = document.getElementById('visorTitulo');
            const visor   = document.getElementById('visorMd');
            const cerrar  = document.getElementById('cerrarVisor');

            // Abrir visor al pulsar un enlace de la tabla
            document.querySelectorAll('a[data-src]').forEach(function (enlace) {
                enlace.addEventListener('click', function (e) {
                    e.preventDefault();
                    const archivo = this.dataset.src;

                    titulo.textContent = archivo;
                    // Asignamos la fuente al componente zero-md
                    visor.setAttribute('src', archivo);
                    overlay.classList.add('activo');
                });
            });

            // Cerrar
            function cerrarVisor() {
                overlay.classList.remove('activo');
                visor.removeAttribute('src');
            }

            cerrar.addEventListener('click', cerrarVisor);

            // Cerrar al hacer clic fuera del modal
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) cerrarVisor();
            });

            // Cerrar con Escape
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && overlay.classList.contains('activo')) {
                    cerrarVisor();
                }
            });
        })();
    </script>
</body>
</html>
